{
  "name": "kodama-kaigi-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomRegistry"] }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "kodama-kaigi-images" }
  ]
}
